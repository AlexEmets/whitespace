# Base URL of services/api (see docs/superpowers/plans/2026-09-08-phases-2-7-full-product.md D3).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_CHAIN_ID=1874
# JSON-RPC endpoint for this app's own chain reads. Unset locally, which falls back to the
# public endpoint in @whitespace/shared/chains. The hosted deployment sets it to
# https://DOMAIN/rpc so every visitor's reads collapse into one cached outbound client
# (hosting design §5). Must be absolute — it is baked in at build time, not read at runtime.
# NEXT_PUBLIC_RPC_URL=https://DOMAIN/rpc
# Public origin of this site, used for absolute URLs in share-link previews (og:image).
# Defaults to https://www.whitespace.finance; a local build sets http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://www.whitespace.finance
# Server-only: where the Next server reaches services/api when it renders a share card.
# Unset, it uses NEXT_PUBLIC_API_BASE_URL (the public route). On the host, the direct
# address avoids a round trip through Caddy.
# API_INTERNAL_BASE_URL=http://127.0.0.1:4000
