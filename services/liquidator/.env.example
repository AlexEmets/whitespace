# services/liquidator — automation bot environment (liquidations, TP, SL, LIMIT/STOP entries)
#
# Read by src/config.mjs (loadConfig). Env first, then deployments/1874.json, then the
# defaults noted per variable. Load it with systemd `EnvironmentFile=` or
# `node --env-file=<file> src/main.mjs`. Never commit a real env file.
#
# TWO INSTANCES: copy this file once per instance. The instances share the database, RPC
# and publisher settings and differ ONLY in the "per instance" block. They need no
# coordination: a trigger the other instance already sent comes back PENDING_TRIGGER /
# NO_TRADE on chain, a status and not a revert.

# ---------------------------------------------------------------- per instance

# Name used as the log prefix. Default: automation-bot.
LIQUIDATOR_INSTANCE_NAME=automation-bot-1

# REQUIRED. This instance's forwarder key file (registered on OstiumTradesUpKeep via
# registerForwarder). Each instance has its own key, so each has its own nonce.
# Holds a live private key: never commit it, never log it.
LIQUIDATOR_FORWARDER_KEY_PATH=/home/youruser/.whitespace-keys/automation-bot-1.json

# Prometheus /metrics and /health. Must differ between instances on one host.
# Default: 9464 on 127.0.0.1.
LIQUIDATOR_METRICS_PORT=9464
LIQUIDATOR_METRICS_HOST=127.0.0.1

# Dead-letter file for triggers that exhausted their retries. Default: in memory only.
LIQUIDATOR_DEAD_LETTER_PATH=/var/lib/whitespace/automation-bot-1-dead-letter.json

# ---------------------------------------------------------------- shared

# REQUIRED. The indexer's Postgres: candidates (open positions, open limit orders) are
# read from it every sweep.
DATABASE_URL=postgres://whitespace:password@127.0.0.1:5432/whitespace

# Postgres schema the indexer writes to (same as the indexer's DATABASE_SCHEMA).
# Default: public.
DATABASE_SCHEMA=public

# Comma-separated JSON-RPC endpoints. Sends fail over in order; liveness probes each one
# and reports it as liquidator_rpc_healthy{endpoint="scheme://host"}.
# Default: https://rpc.testnet.whitechain.io
LIQUIDATOR_RPC_URLS=https://rpc.testnet.whitechain.io

# services/price-publisher: /status gives the mark and bid/ask a report would carry.
# Default: http://127.0.0.1:8787
LIQUIDATOR_PUBLISHER_URL=http://127.0.0.1:8787

# Contract addresses. Default: deployments/1874.json `contracts.<name>`; fatal if absent.
# LIQUIDATOR_TRADES_UPKEEP_ADDRESS=
# LIQUIDATOR_TRADING_ADDRESS=
# LIQUIDATOR_TRADING_STORAGE_ADDRESS=
# LIQUIDATOR_PAIR_INFOS_ADDRESS=
# LIQUIDATOR_PAIRS_STORAGE_ADDRESS=
# LIQUIDATOR_CHAIN_ID=1874

# Pause between the end of one sweep and the start of the next, ms. Default: 2000.
LIQUIDATOR_POLLING_INTERVAL_MS=2000

# Most triggers in one performUpkeep transaction. Default: 20.
LIQUIDATOR_MAX_BATCH_SIZE=20

# After a trigger is sent (success or failure) it is not re-sent for this long, ms.
# Covers a NOT_HIT round trip and the contract's 30-block triggerTimeout. Default: 30000.
LIQUIDATOR_TRIGGER_COOLDOWN_MS=30000

# Liquidate while the market is degraded (< its minimum healthy venues). Default: false
# (docs/decisions/phase-6-liquidator.md §4). SL/TP always flow; LIMIT/STOP never do.
LIQUIDATOR_LIQUIDATE_WHEN_DEGRADED=false

# Send retries per performUpkeep before the batch is dead-lettered. Default: 3.
LIQUIDATOR_MAX_RETRIES=3
