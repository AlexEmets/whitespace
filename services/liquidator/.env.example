# services/liquidator — environment
#
# Every variable below is read by src/config.mjs (loadConfig), in this order.
# All are optional: with no env at all the service falls back to
# deployments/1874.json and the in-code defaults noted per variable.
# Copy to `.env` and edit. Never commit the real `.env` (see .gitignore).

# Chain id the liquidator reads from and submits to.
# Default: deployments/1874.json `chainId`, else 1874.
LIQUIDATOR_CHAIN_ID=1874

# OstiumTradingStorage — source of open positions / pending orders.
# Default: deployments/1874.json `contracts.tradingStorage`.
# Fatal if neither this nor deployments/1874.json provides a value.
LIQUIDATOR_TRADING_STORAGE_ADDRESS=0xb51217a43BF812B354E18977a4781909C4d33341

# OstiumPairInfos — funding/rollover params used by the margin engine.
# Default: deployments/1874.json `contracts.pairInfos`. Fatal if absent.
LIQUIDATOR_PAIR_INFOS_ADDRESS=0xF87205EbCf03513D24B998925109FcB84Ce84ED1

# OstiumPairsStorage — per-pair configuration (leverage, fees, groups).
# Default: deployments/1874.json `contracts.pairsStorage`. Fatal if absent.
LIQUIDATOR_PAIRS_STORAGE_ADDRESS=0xc5B68AfA8f64288f6d06DEfC5c07555Ef5323397

# OstiumTradingCallbacks — used when building automation perform data.
# Default: deployments/1874.json `contracts.callbacks`. Fatal if absent.
LIQUIDATOR_CALLBACKS_ADDRESS=0x4084cd63dB84c88c98418e33b88449b3b006da9c

# OstiumTradesUpKeep — the ONLY contract allowed to call
# OstiumTrading.executeAutomationOrder (gated `onlyTradesUpKeep`).
# Default: deployments/1874.json `contracts.tradesUpKeep` — which DOES NOT
# EXIST today; Deploy.s.sol never deploys OstiumTradesUpKeep, so this resolves
# to undefined. Deliberately NOT fatal at startup (see the config.mjs header
# and docs/decisions/phase-6-liquidator.md): the service still monitors, and
# the code paths that need this address fail loudly and specifically.
# Leave empty until TradesUpKeep is deployed and registered on 1874.
LIQUIDATOR_TRADES_UPKEEP_ADDRESS=

# Comma-separated JSON-RPC endpoints, tried in order for failover.
# Default: https://rpc.testnet.whitechain.io (the only documented 1874 endpoint).
LIQUIDATOR_RPC_URLS=https://rpc.testnet.whitechain.io

# Base URL of services/price-publisher, where signed reports are fetched.
# Default: http://127.0.0.1:8787 (matches PUBLISHER_PORT's default).
LIQUIDATOR_PUBLISHER_URL=http://127.0.0.1:8787

# Absolute path to the liquidator's forwarder role-key JSON file (the EOA that
# signs and pays for liquidation txs).
# Default: $HOME/.whitespace-keys/liquidator.json
# This file holds a live private key — never commit it, never log it.
LIQUIDATOR_FORWARDER_KEY_PATH=/home/youruser/.whitespace-keys/liquidator.json

# Interval in milliseconds between position-table refresh / margin sweeps.
# Default: 2000.
LIQUIDATOR_POLLING_INTERVAL_MS=2000

# Max send/retry attempts per liquidation before the job is dead-lettered.
# Default: 3.
LIQUIDATOR_MAX_RETRIES=3

# Absolute path to the dead-letter file for permanently failed jobs.
# Default: null — dead-lettering to disk is DISABLED unless this is set.
LIQUIDATOR_DEAD_LETTER_PATH=/var/lib/whitespace/liquidator-dead-letter.jsonl

# TCP port for the Prometheus metrics / health endpoint. Default: 9464.
LIQUIDATOR_METRICS_PORT=9464

# HOME is read indirectly by config.mjs to build the default forwarder key
# path. It is NOT validated: if HOME is unset the default path becomes the
# literal "undefined/.whitespace-keys/liquidator.json" and startup fails with
# a confusing ENOENT. Set LIQUIDATOR_FORWARDER_KEY_PATH explicitly under
# systemd rather than relying on HOME.
# HOME=/home/youruser
