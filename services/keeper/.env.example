# services/keeper — environment
#
# Every variable below is read by src/config.mjs (loadConfig), in this order.
# All are optional: with no env at all the service falls back to
# deployments/1874.json and the in-code defaults noted per variable.
# Copy to `.env` and edit. Never commit the real `.env` (see .gitignore).

# Chain id the keeper submits transactions to.
# Default: deployments/1874.json `chainId`, else 1874.
KEEPER_CHAIN_ID=1874

# OstiumPriceUpKeep contract — the keeper's fulfilment target.
# Default: deployments/1874.json `contracts.priceUpKeep`.
# Fatal if neither this nor deployments/1874.json provides a value —
# loadConfig throws at startup.
KEEPER_PRICE_UPKEEP_ADDRESS=0x6d8fa4DE0DD0aF71F044266aA630B560733efC96

# Comma-separated JSON-RPC endpoints, tried in order for failover.
# Default: https://rpc.testnet.whitechain.io (the only documented 1874 endpoint).
KEEPER_RPC_URLS=https://rpc.testnet.whitechain.io

# Base URL of services/price-publisher, where signed reports are fetched.
# Default: http://127.0.0.1:8787 (matches PUBLISHER_PORT's default).
KEEPER_PUBLISHER_URL=http://127.0.0.1:8787

# Absolute path to the keeper's forwarder role-key JSON file (the EOA that
# signs and pays for fulfilment txs).
# Default: $HOME/.whitespace-keys/keeper.json
# This file holds a live private key — never commit it, never log it.
KEEPER_FORWARDER_KEY_PATH=/home/youruser/.whitespace-keys/keeper.json

# Interval in milliseconds between polls for PriceRequestedV2 logs.
# Default: 2000. Must be a positive integer (startup fails otherwise).
KEEPER_POLLING_INTERVAL_MS=2000

# Orders handled at once within one polled window. Report fetches run side by side;
# transactions still go out one at a time through the serial nonce queue.
# Default: 4.
KEEPER_CONCURRENCY=4

# Retries per order after the first attempt (a revert, a refused broadcast, or a
# receipt that never came) before the order is dead-lettered.
# Default: 3.
KEEPER_MAX_RETRIES=3

# How long to wait for a receipt before re-broadcasting the SAME nonce at 1.2x gas.
# Default: 30000.
KEEPER_RECEIPT_TIMEOUT_MS=30000

# Max same-nonce replacements per attempt. Default: 3.
KEEPER_MAX_GAS_BUMPS=3

# Dead-letter file (JSON Lines, append-only; `resolved` lines mark later deliveries).
# Only the newest 100 unresolved entries are held in memory.
# Default: null — dead letters are kept in memory only unless this is set.
KEEPER_DEAD_LETTER_PATH=/var/lib/whitespace/keeper-dead-letter.jsonl

# File holding the next block to scan. A restart resumes from it, so orders placed
# while the keeper was down are still filled.
# Default: null — NOT persisted; a restart starts at the head and misses them.
KEEPER_CURSOR_PATH=/var/lib/whitespace/keeper-cursor.json

# A resumed cursor never starts further back than this many blocks behind the head.
# Orders older than the report maxAge (10 s) cannot be filled any more anyway.
# Default: 300.
KEEPER_MAX_LOOKBACK_BLOCKS=300

# GET /health (200 while polling, 503 before the first poll or once polls stall) and
# GET /metrics (Prometheus text). Loopback unless the host is overridden.
# Defaults: 127.0.0.1 and 9465 (the liquidator uses 9464).
KEEPER_METRICS_HOST=127.0.0.1
KEEPER_METRICS_PORT=9465

# HOME is read indirectly by config.mjs to build the default forwarder key
# path. It is NOT validated: if HOME is unset the default path becomes the
# literal "undefined/.whitespace-keys/keeper.json" and startup fails with a
# confusing ENOENT. Set KEEPER_FORWARDER_KEY_PATH explicitly under systemd.
# HOME=/home/youruser
