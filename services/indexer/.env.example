# services/indexer — environment
#
# Copy to `.env` and edit. Never commit the real `.env` (see .gitignore).
# Ponder loads `.env.local` / `.env` from this directory automatically.

# --- Read by this repo's own code (ponder.config.ts) ---

# Comma-separated JSON-RPC endpoints for chain 1874, wrapped in viem's
# `fallback()` for failover. Whitespace is trimmed and empty entries dropped.
# Default: https://rpc.testnet.whitechain.io
# WARNING (from ponder.config.ts): `rpc-testnet.whitechain.io` — with a hyphen —
# is chain 2625, a DIFFERENT network. Never point this at it.
# Note: the chain id (1874), all contract addresses and `startBlock` are NOT
# configurable by env; they are compiled in from deployments/1874.json.
PONDER_RPC_URLS_1874=https://rpc.testnet.whitechain.io

# Block where the liveness heartbeat begins. Default in ponder.config.ts: 7_373_000.
#
# This is the single largest cold-start hazard in the whole stack, and it fails in a way
# that looks like a hung deploy rather than an error. The heartbeat block source runs at
# `interval: 5`, so a cold sync issues one `eth_getBlockByNumber` per five blocks of the
# gap, and this RPC serves roughly 6 blocks/s. Measured 2026-09-21: head of 1874 was
# 8 406 360, so booting on the 7_373_000 default would mean ~206k calls — over nine hours
# before /health reports ok.
#
# Therefore: re-measure the head and bump this to just below it before ANY first boot
# against an empty database. Contract indexing is not affected — it is chunked
# `eth_getLogs` from the compiled-in startBlock and takes minutes.
#
#   curl -s -X POST https://rpc.testnet.whitechain.io \
#     -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber","params":[]}'
HEARTBEAT_START_BLOCK=8400000

# --- Read by the Ponder framework (ponder@0.16.10), not by this repo's code ---
# Listed because they are load-bearing for running this service; verified by
# inspecting ponder's dist rather than assumed.

# Postgres connection string for the indexed data.
# No default: when unset, Ponder falls back to an embedded PGlite database,
# which is fine for `ponder dev` but is NOT what services/api reads. For any
# real run, set this to the same database DATABASE_URL points at in
# services/api/.env.
DATABASE_URL=postgresql://whitespace:whitespace@127.0.0.1:5433/whitespace

# Postgres schema the indexed tables are created in. Default: public.
DATABASE_SCHEMA=public

# TCP port for Ponder's own HTTP server (GraphQL + the routes in
# src/api/index.ts). Default: 42069. Distinct from services/api's PORT.
PORT=42069

# Ponder log verbosity: error | warn | info | debug | trace. Default: info.
PONDER_LOG_LEVEL=info

# Set to any truthy value to disable Ponder's anonymous usage telemetry.
# Default: unset (telemetry enabled).
PONDER_TELEMETRY_DISABLED=1
