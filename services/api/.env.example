# services/api — environment
#
# This service has no central config module; the three variables below are
# every `process.env` read under src/. Copy to `.env` and edit.
# Never commit the real `.env` (see .gitignore).

# TCP port the HTTP + WebSocket server listens on.
# Read in src/server.ts, and ONLY when the module is run directly
# (`pnpm start` / `pnpm dev`) — importing createApp() ignores it.
# Default: 3001.
# NOTE: apps/web/.env.example points the frontend at port 4000, so one of the
# two has to be overridden for the local stack to line up.
PORT=4000
# Bind address. Loopback by default; Caddy is the only thing that should reach this.
HOST=127.0.0.1

# Postgres connection string for the database services/indexer writes into.
# Read lazily in src/db.ts on the first query, NOT at startup: if it is unset
# the process boots and binds the port fine, then every data route 500s with
# "DATABASE_URL is required". /health fails this way too.
# REQUIRED — no default.
DATABASE_URL=postgresql://whitespace:whitespace@127.0.0.1:5433/whitespace

# Chain id reported by GET /health and used to select the `sync_status` row.
# Read at module load in src/routes/health.ts. Default: 1874.
CHAIN_ID=1874

# Browser origins allowed to read this API. Cross-origin by construction: the web app
# runs on a different port, so without a matching entry here every fetch is discarded by
# the browser while the server logs a normal 200. Comma-separated; an allowlist rather
# than "*", and the matched origin is echoed back.
# Default: http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of services/price-publisher, the source of the live index/mark price and of
# the index series the chart is drawn from (src/publisher.ts, src/indexSeries.ts).
# When unreachable, /price falls back to the last on-chain report and says so via
# `source: "chain"` — the API stays up, the price just stops being live.
# Default: http://127.0.0.1:8787 (matches PUBLISHER_PORT's default).
PUBLISHER_URL=http://127.0.0.1:8787
