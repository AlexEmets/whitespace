# services/api — environment
#
# This service has no central config module; the three variables below are
# every `process.env` read under src/. Copy to `.env` and edit.
# Never commit the real `.env` (see .gitignore).

# TCP port the HTTP + WebSocket server listens on.
# Read in src/server.ts, and ONLY when the module is run directly
# (`pnpm start` / `pnpm dev`) — importing createApp() ignores it.
# Default: 3001.
# NOTE: apps/web/.env.example points the frontend at port 4000, so one of the
# two has to be overridden for the local stack to line up.
PORT=4000

# Postgres connection string for the database services/indexer writes into.
# Read lazily in src/db.ts on the first query, NOT at startup: if it is unset
# the process boots and binds the port fine, then every data route 500s with
# "DATABASE_URL is required". /health fails this way too.
# REQUIRED — no default.
DATABASE_URL=postgresql://whitespace:whitespace@127.0.0.1:5433/whitespace

# Chain id reported by GET /health and used to select the `sync_status` row.
# Read at module load in src/routes/health.ts. Default: 1874.
CHAIN_ID=1874
