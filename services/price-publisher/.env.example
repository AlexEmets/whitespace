# services/price-publisher — environment
#
# Every variable below is read by src/config.mjs (loadConfig), in this order.
# All are optional: with no env at all the service falls back to
# deployments/1874.json plus the constants in @whitespace/shared.
# Copy to `.env` and edit. Never commit the real `.env` (see .gitignore).

# Chain id the signed price reports are bound to.
# Default: deployments/1874.json `chainId`, else 1874.
PUBLISHER_CHAIN_ID=1874

# Address of the k-of-N verifier contract the report wire format targets.
# Default: deployments/1874.json `contracts.verifier`.
# Fatal if neither this nor deployments/1874.json provides a value —
# loadConfig throws at startup.
# NOTE (from config.mjs): the address below is the OLD 1-of-N OstiumVerifier.
# The k-of-N verifier is being built concurrently; override this once deployed.
PUBLISHER_VERIFIER_ADDRESS=0xf2236F1Cc7610D75DD1D38563aA090bdD7102Fc8

# TCP port the publisher's HTTP report server listens on. Default: 8787.
PUBLISHER_PORT=8787

# Comma-separated market feed ids to publish.
# Default: MARKET_FEEDS from @whitespace/shared/markets == BTC/USD,ETH/USD.
PUBLISHER_MARKETS=BTC/USD,ETH/USD

# Comma-separated venue ids to aggregate prices from.
# Default: VENUE_IDS from @whitespace/shared/venues == binance,bybit,okx,whitebit.
PUBLISHER_VENUES=binance,bybit,okx,whitebit

# k in the k-of-N signature threshold for a valid report.
# Default: SIGNATURE_THRESHOLD_K from @whitespace/shared/bounds == 3 (of N=5).
PUBLISHER_SIGNATURE_THRESHOLD_K=3

# Comma-separated absolute paths to signer role-key JSON files.
# Default: $HOME/.whitespace-keys/signer.json (single key).
# Each file is a role key as described in packages/shared/src/keys.mjs.
# These files hold live private keys — never commit them, never log them.
PUBLISHER_SIGNER_KEY_PATHS=/home/youruser/.whitespace-keys/signer.json

# HOME is read indirectly by config.mjs to build the default signer key path.
# It is NOT validated: if HOME is unset (e.g. under a bare systemd unit) the
# default path becomes the literal "undefined/.whitespace-keys/signer.json"
# and startup fails with a confusing ENOENT. Set PUBLISHER_SIGNER_KEY_PATHS
# explicitly in service managers rather than relying on HOME.
# HOME=/home/youruser
