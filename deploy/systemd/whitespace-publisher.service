[Unit]
Description=Whitespace price publisher (k-of-N signed price reports)
Documentation=file:/home/whitespace/whitespace/docs/runbooks/deploy-server.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whitespace
Group=whitespace
WorkingDirectory=/home/whitespace/whitespace/services/price-publisher
EnvironmentFile=/home/whitespace/whitespace/services/price-publisher/.env
# HOME must be set explicitly. The .env.example files warn repeatedly that an unset HOME
# resolves key paths to a literal `undefined/...` and dies with ENOENT — systemd does not
# provide HOME for a User= unit unless asked.
Environment=HOME=/home/whitespace
ExecStart=/usr/bin/node src/main.mjs
Restart=always
RestartSec=5
# Measured 41 MB PSS in steady state; this is a backstop, not a target.
# Memory budget (see docker-compose.yml and deploy/test/memoryBudget.test.mjs): MemoryHigh
# is where systemd starts reclaiming from this unit, MemoryMax the hard kill, and the V8 heap
# cap sits under both so Node collects garbage before the cgroup has to step in. The sum of
# every MemoryMax plus the container limits stays inside physical RAM; it used to exceed it,
# so under load the kernel OOM killer chose for us, and it chose Postgres.
MemoryHigh=80M
MemoryMax=96M
Environment=NODE_OPTIONS=--max-old-space-size=56

[Install]
WantedBy=multi-user.target
