[Unit]
Description=Whitespace automation bot %i (liquidations, TP/SL, limit and stop entries)
Documentation=file:/home/whitespace/whitespace/docs/runbooks/deploy-server.md
After=network-online.target whitespace-indexer.service whitespace-keeper.service
Wants=network-online.target

[Service]
Type=simple
User=whitespace
Group=whitespace
WorkingDirectory=/home/whitespace/whitespace/services/liquidator
# One env file per instance: its own forwarder key, instance name and metrics port. Two
# instances (`a`, `b`) run with two allowlisted forwarder keys. They split the triggers by
# key (instance `a` owns index 0, `b` index 1) and each takes over the other's after a delay,
# so a trigger is not sent twice and the losing copy no longer burns gas as PENDING_TRIGGER.
Environment=LIQUIDATOR_INSTANCE_COUNT=2
Environment=LIQUIDATOR_INSTANCE_ID=%i
EnvironmentFile=/home/whitespace/whitespace/services/liquidator/.env.%i
Environment=HOME=/home/whitespace
ExecStart=/usr/bin/node src/main.mjs
Restart=always
RestartSec=5
# Memory budget (see docker-compose.yml and deploy/test/memoryBudget.test.mjs): MemoryHigh
# is where systemd starts reclaiming from this unit, MemoryMax the hard kill, and the V8 heap
# cap sits under both so Node collects garbage before the cgroup has to step in. The sum of
# every MemoryMax plus the container limits stays inside physical RAM; it used to exceed it,
# so under load the kernel OOM killer chose for us, and it chose Postgres.
MemoryHigh=88M
MemoryMax=104M
Environment=NODE_OPTIONS=--max-old-space-size=64

[Install]
WantedBy=multi-user.target
