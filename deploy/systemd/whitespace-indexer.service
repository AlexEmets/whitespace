[Unit]
Description=Whitespace indexer (Ponder, chain 1874 -> Postgres)
Documentation=file:/home/whitespace/whitespace/docs/runbooks/deploy-server.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=whitespace
Group=whitespace
WorkingDirectory=/home/whitespace/whitespace/services/indexer
# EnvironmentFile rather than relying on Ponder's own dotenv loading: verified by
# experiment that `ponder start` does NOT pick up `.env` from the service directory (it
# looks for `.env.local`), and dies with "Database schema required" when DATABASE_SCHEMA
# is only in `.env`. systemd loading the file removes that ambiguity entirely.
EnvironmentFile=/home/whitespace/whitespace/services/indexer/.env
# Written by deploy/deploy.sh: DATABASE_SCHEMA=ws1874_<sha> for THIS build (deploy/indexer-schema.sh).
# Later file wins, so it overrides any DATABASE_SCHEMA left in .env.
EnvironmentFile=/home/whitespace/whitespace/services/indexer/.env.build
Environment=HOME=/home/whitespace
# The views pattern: each build writes its own schema; once it is synced Ponder repoints the
# stable views in `ws1874` at it. The API (INDEXER_SCHEMA) and the bots (DATABASE_SCHEMA) read
# only `ws1874`, so an indexer deploy never breaks them, and the previous build keeps serving
# until the new one is ready.
# --log-level on the command line, not PONDER_LOG_LEVEL: the .env above sets it to info
# and EnvironmentFile wins over Environment=. At info, RPC retries filled the disk (deploy/journald).
ExecStart=/home/whitespace/whitespace/services/indexer/node_modules/.bin/ponder start --hostname 127.0.0.1 --log-level warn --schema ${DATABASE_SCHEMA} --views-schema ws1874
Restart=always
RestartSec=5
# Measured 203 MB PSS at peak during historical backfill, which is the heaviest phase.
# Memory budget (see docker-compose.yml and deploy/test/memoryBudget.test.mjs): MemoryHigh
# is where systemd starts reclaiming from this unit, MemoryMax the hard kill, and the V8 heap
# cap sits under both so Node collects garbage before the cgroup has to step in. The sum of
# every MemoryMax plus the container limits stays inside physical RAM; it used to exceed it,
# so under load the kernel OOM killer chose for us, and it chose Postgres.
MemoryHigh=272M
MemoryMax=320M
# IPv4 first: the RPC provider raised its rate limit for 65.21.53.147, and Node otherwise
# reaches rpc.testnet.whitechain.io over this host\'s IPv6, which the raised limit does not cover.
Environment=NODE_OPTIONS=--max-old-space-size=208 --dns-result-order=ipv4first

[Install]
WantedBy=multi-user.target
