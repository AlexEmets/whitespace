# Installed over /etc/logrotate.d/rsyslog (see docs/runbooks/deploy-server.md).
# Size-bounded as well as daily: with journald no longer forwarding, little reaches syslog,
# but a weekly rotation with no size cap is what let it reach 28 GB once already.
/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/cron.log
{
	rotate 4
	daily
	maxsize 200M
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
