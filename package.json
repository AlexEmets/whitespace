{
  "name": "whitespace",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:contracts": "cd contracts && forge build --sizes",
    "test:contracts": "cd contracts && forge test",
    "test:tools": "node --test tools/",
    "test:packages": "pnpm -r --filter './packages/**' test",
    "test:services": "pnpm -r --filter './services/**' test",
    "stack": "node tools/stack/run.mjs",
    "stack:list": "node tools/stack/run.mjs --list",
    "gate:evm": "node tools/evm-compat/scan.mjs contracts/out",
    "gate:toolchain": "cd contracts && forge config --json > /tmp/fc.json && node ../tools/evm-compat/toolchain.mjs /tmp/fc.json",
    "probe:chains": "node tools/chain-probe/probe.mjs",
    "deploy:1874": "cd contracts && forge script script/Deploy.s.sol:DeployScript --rpc-url https://rpc.testnet.whitechain.io --broadcast --legacy -vvv",
    "deploy:2625": "cd contracts && forge script script/Deploy.s.sol:DeployScript --rpc-url https://rpc-testnet.whitechain.io --broadcast --legacy -vvv"
  }
}
